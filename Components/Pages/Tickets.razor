@page "/tickets"
@using System.Net.Http.Json
@using ServiceTicketWeb.Models
@inject HttpClient Http

<PageTitle>Service Tickets</PageTitle>

<style>
    .status-purple {
        background-color: #47265E;
        color: white;
    }

    .status-gold {
        background-color: #CFA139;
        color: #47265E;
    }

    .status-blue {
        background-color: #225A7B;
    color: white;
}
</style>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="h2 mb-1">Service Tickets</h1>
            <p class="text-secondary mb-0">
                View and track submitted support requests.
            </p>
        </div>

        <a href="/tickets/create" class="btn btn-primary mt-3 mt-md-0">
            Create New Ticket
        </a>

        @if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
        {
            <span class="badge rounded-pill status-blue fs-6 mt-3 mt-md-0">
                @tickets.Count ticket@(tickets.Count == 1 ? "" : "s")
            </span>
        }
    </div>

    @if (isLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary"
                     role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-secondary mt-3 mb-0">
                    Loading tickets...
                </p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading">Unable to load tickets</h4>
            <p class="mb-0">@errorMessage</p>
        </div>
    }
    else if (tickets.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5">No tickets found</h2>
                <p class="text-secondary mb-0">
                    The API did not return any service tickets.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">ID</th>
                            <th class="py-3">Ticket</th>
                            <th class="py-3">Description</th>
                            <th class="px-4 py-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var ticket in tickets)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-secondary">
                                    #@ticket.TicketId
                                </td>

                                <td>
                                    <a href="/ticket/@ticket.TicketId"
                                       class="fw-semibold text-decoration-none">
                                        @ticket.Title
                                    </a>
                                </td>

                                <td class="text-secondary">
                                    @ticket.Description
                                </td>

                                <td class="px-4">
                                    <span class="badge rounded-pill @GetStatusClass(ticket.Status)">
                                        @ticket.Status
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Ticket> tickets = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tickets =
                await Http.GetFromJsonAsync<List<Ticket>>("tickets")
                ?? new List<Ticket>();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"API request failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusClass(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "new" => "status-purple",
            "open" => "status-purple",
            "in progress" => "status-gold",
            "resolved" => "status-blue",
            "closed" => "status-blue",
            _ => "status-purple"
        };
    }
   
}
